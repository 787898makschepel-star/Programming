# ============================================================
#  WILLI WONKA Bot — переменные окружения
#  Скопируйте этот файл в .env и заполните значения
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Основной токен бота (получить у @BotFather)
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Второй токен (опционально — для запуска двух ботов сразу)
BOT_TOKEN_2=

# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ── База данных ───────────────────────────────────────────────
# SQLite (по умолчанию, файлы хранятся в папке data/):
DB_URL=sqlite+aiosqlite:///data/bot.db

# PostgreSQL (для bot-hosting.net — вставьте строку подключения из панели):
# DB_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Группа чеков ─────────────────────────────────────────────
# ID группы, куда бот пересылает подтверждения оплаты (отрицательное число)
RECEIPTS_GROUP_ID=-100


# ── Ссылки и сервисы ─────────────────────────────────────────
SUPPORT_USERNAME=@your_support
REVIEWS_CHANNEL=@your_reviews
FAQ_URL=https://telegra.ph/your-faq

# ── Стартовый стикер (опционально) ───────────────────────────
START_STICKER_ID=

# ── Платёжные системы (опционально) ──────────────────────────
# CryptoBot (https://t.me/CryptoBot)
CRYPTO_BOT_TOKEN=

# Telegram Payments (провайдерский токен от BotFather)
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
